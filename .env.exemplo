# Copie para `.env` (que fica fora do git) e preencha UM dos dois blocos.
# Sem nada preenchido, o servidor sobe com uma lâmpada simulada.

# --- Modo local: fala direto com a lâmpada pelo Wi-Fi (recomendado) -------
# `npx @tuyapi/cli wizard` lista o id e a key — veja o README.
TUYA_ID=
TUYA_KEY=
# Opcional. Vazio = procura a lâmpada na rede sozinho.
TUYA_IP=
# Só vale quando TUYA_IP está preenchido: 3.3 (padrão), 3.4 ou 3.5.
TUYA_VERSAO=3.3

# --- Modo nuvem: passa pela OpenAPI da Tuya (se a key local não sair) ----
# Access ID/Secret do projeto em iot.tuya.com. TUYA_ID é o mesmo de cima.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# us (Western America, o data center do Brasil), us-e, eu, eu-w, cn, in
TUYA_REGIAO=us

# --- Servidor que a página /luz chama ------------------------------------
# Força um modo: local | nuvem | simulada (padrão: deduz pelo que está acima)
# LAMPADA_MODO=simulada
LAMPADA_PORTA=3131
# Outras origens do site autorizadas a chamar o servidor, separadas por vírgula
# (localhost e zeno.net.br já entram). Ex.: https://zeno-net.conta.workers.dev
LAMPADA_ORIGENS=
